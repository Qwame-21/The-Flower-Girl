# Safe to expose in the browser. Use a Paystack public test key only.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# The future server endpoint that initializes an order payment.
VITE_PAYMENT_INITIALIZE_ENDPOINT=/api/payments/initialize

# Never place the Paystack secret key in a Vite VITE_* variable.
# Keep PAYSTACK_SECRET_KEY in the future server environment only.
