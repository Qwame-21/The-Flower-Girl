# ── Browser-safe variables (safe to commit, safe in Vite) ────────────────────

# Paystack publishable/public test key (pk_test_…). Safe in the browser.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# Your Supabase project URL and publishable (anon) key. Both are safe in Vite.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Edge Function URLs (constructed from VITE_SUPABASE_URL at runtime in the app).
# These are just documentation — the app builds them dynamically.
# PAYSTACK_INIT_URL  = ${VITE_SUPABASE_URL}/functions/v1/paystack-init
# WEBHOOK_URL        = ${VITE_SUPABASE_URL}/functions/v1/paystack-webhook

# ── Server-side secrets — NEVER add VITE_ prefix to these ────────────────────
# Set these ONLY in Supabase Dashboard → Edge Functions → Secrets.

# PAYSTACK_SECRET_KEY=sk_test_replace_me          ← Supabase Edge Function secret
# SUPABASE_SERVICE_ROLE_KEY=replace_me            ← auto-injected by Supabase runtime
